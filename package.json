{
  "name": "sepire-explorer",
  "private": true,
  "version": "1.0.0",
  "description": "Sepire Interactive Statement Explorer — from PDF to interactive statement.",
  "type": "module",
  "scripts": {
    "prepare:statement": "node scripts/prepare-statement.mjs",
    "dev": "npm run prepare:statement && vite",
    "build": "npm run prepare:statement && npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "cm6-graphql": "^0.2.2",
    "graphql": "^17.0.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
